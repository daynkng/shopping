PORT=4317
HOST=127.0.0.1
# Native agent connections. Choose a model available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
XAI_API_KEY=
GROK_MODEL=grok-4.7
# Required for personalized ranking.
SUPERLINKED_API_KEY=
SUPERLINKED_BASE_URL=https://api.superlinked.com
SUPERLINKED_MODEL=Qwen/Qwen3-Reranker-0.6B
# Sample context needs no Cognee credentials. Never falls back if cognee is selected.
CONTEXT_SOURCE=sample
COGNEE_API_KEY=
# Copy your tenant API URL from Cognee Cloud, not its dashboard URL.
COGNEE_BASE_URL=
COGNEE_MAYA_DATASET_ID=
COGNEE_JORDAN_DATASET_ID=
COGNEE_DATASET_PREFIX=known-demo

# Required for in-app connections on deployed hosts; 32 random bytes as base64 or hex.
# Local development uses an ephemeral key if omitted.
SESSION_ENCRYPTION_KEY=
