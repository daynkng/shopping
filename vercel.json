{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/search.js": {
      "maxDuration": 60
    },
    "api/context.js": {
      "maxDuration": 30
    },
    "api/preference.js": {
      "maxDuration": 60
    },
    "api/connection-test.js": {
      "maxDuration": 60
    },
    "api/connections.js": {
      "maxDuration": 60
    },
    "api/feedback.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/demo/maya",
      "destination": "/index.html"
    },
    {
      "source": "/demo/jordan",
      "destination": "/index.html"
    },
    {
      "source": "/profiles/maya",
      "destination": "/index.html"
    },
    {
      "source": "/profiles/jordan",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
